{
  "hyprland/workspaces#pacman": {
    "disable-scroll": true,
    "persistent-only": true,
    "all-outputs": false,
    "on-click": "activate",
    "show-special": false,
    "persistent-workspaces": {
      "eDP-1": [1,2,3,4,5],
      "DP-3": [11,12,13,14,15],
      "HDMI-A-1": [11,12,13,14,15],
      "DP-4": [11,12,13,14,15]
    },
    "format": "{icon}",
    "format-icons": {
      "active": " 󰮯 ",
      "default": "󰊠",
      "persistent": "󰊠"
    }
  },

  "group/motherboard": {
    "orientation": "horizontal",
    "modules": [
      "custom/polycat",
      "memory",
      "custom/temp"
    ]
  },

  "group/laptop": {
    "orientation": "horizontal",
    "modules": [
      "backlight",
      "battery"
    ]
  },

  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "pulseaudio#microphone"
    ]
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "~/.config/niri/scripts/Brightness.sh --inc",
    "on-scroll-down": "~/.config/niri/scripts/Brightness.sh --dec"
  },

  "custom/cava": {
    "exec": "~/.config/niri/scripts/WaybarCava.sh",
    "return-type": "json",
    "on-click": "~/.config/niri/scripts/WaybarCava.sh play-toggle",
    "on-click-right": "~/.config/niri/scripts/WaybarCava.sh switch-player",
    "signal": 9,
    "restart-interval": 1
  },

  "custom/polycat": {
    "format": "{}",
    "exec": "/usr/bin/polycat --config-path ~/.config/polycat/polycat-config --stat-path /proc/stat",
    "on-click": "kitty -e btop"
  },

  "battery": {
    "align": 0,
    "rotate": 0,
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": "󱘖 {capacity}%",
    "format-alt-click": "click",
    "format-full": "{icon} Full",
    "format-alt": "{icon} {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-time": "{H}h {M}min",
    "tooltip": true,
    "tooltip-format": "{timeTo} {power}w"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂳",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": " {device_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": " {device_alias} 󰂄{device_battery_percentage}%",
    "tooltip": true,
    "on-click": "blueman-manager"
  },

  "clock": {
    "interval": 1,
    "format": "{:%I:%M:%S %p}",
    "tooltip-format": "{:%D}"
  },

  "niri/window": {
      "format": "{}",
      "separate-outputs": true,
      "expand": true,
      "min-length": 90,
      "max-length": 90
  },

  "memory": {
    "interval": 2,
    "format": "󰍛 {percentage}%",
    "tooltip": true,
    "tooltip-format": "{used:0.1f}GB/{total:0.1f}G"
  },

  "network": {
    "interval": 1,
    "format": " {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-wifi": " {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-ethernet": " {bandwidthUpBytes}  {bandwidthDownBytes}",
    "format-disconnected": "󰌙  Offline..."
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "{icon} 󰂰 {volume}%",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        "",
        ""
      ],
      "ignored-sinks": [
        "Easy Effects Sink"
      ]
    },
    "scroll-step": 5.0,
    "on-click": "~/.config/niri/scripts/Volume.sh --toggle",
    "on-click-right": "kitty --class pulsemixer -e pulsemixer",
    "on-scroll-up": "~/.config/niri/scripts/Volume.sh --inc",
    "on-scroll-down": "~/.config/niri/scripts/Volume.sh --dec",
    "tooltip-format": "{desc}",
    "smooth-scrolling-threshold": 1
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "on-click": "~/.config/niri/scripts/Volume.sh --toggle-mic",
    "on-click-right": "kitty --class pulsemixer -e pulsemixer",
    "on-scroll-up": "~/.config/niri/scripts/Volume.sh --mic-inc",
    "on-scroll-down": "~/.config/niri/scripts/Volume.sh --mic-dec",
    "tooltip-format": "{source_desc}",
    "scroll-step": 5
  },

  "custom/temp": {
    "format": "{}",
    "return-type": "text",
    "exec": "~/.config/niri/scripts/AvgTemp.sh",
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "Average CPU Temp"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "custom/power": {
    "format": "⏻  ",
    "exec": "echo ; echo Power Menu",
    "on-click": "$HOME/.config/niri/scripts/TofiPowerMenu.sh",
    "interval": "once",
    "tooltip": true
  },

  "custom/night": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/niri/scripts/NightMode.sh",
    "on-click": "$HOME/.config/niri/scripts/NightMode.sh toggle && pkill -SIGRTMIN+10 waybar",
    "signal": 10,
    "tooltip": true,
    "tooltip-format": "Night Mode"
  },

  "custom/waydroid": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/niri/scripts/WaydroidWaybar.sh",
    "on-click": "$HOME/.config/niri/scripts/WaydroidWaybar.sh toggle && pkill -SIGRTMIN+20 waybar",
    "signal": 20,
    "tooltip": true,
    "tooltip-format": "Waydroid Container",
    "interval": 5
  },

  "custom/rotate-toggle": {
      "format": "{}",
      "return-type": "json",
      "exec": "$HOME/.config/niri/scripts/AutoRotate.sh",
      "on-click": "$HOME/.config/niri/scripts/AutoRotate.sh toggle && pkill -SIGRTMIN+13 waybar",
      "signal": 13,
      "tooltip": true,
      "tooltip-format": "Auto Rotate"
  },

  "custom/touch-toggle": {
    "format": "{}",
    "return-type": "json",
    "exec": "$HOME/.config/niri/scripts/ToggleTouch.sh",
    "on-click": "$HOME/.config/niri/scripts/ToggleTouch.sh toggle && pkill -SIGRTMIN+11 waybar",
    "signal": 11,
    "tooltip": true,
    "tooltip-format": "Touch Mode"
  },

  "custom/updater": {
    "format": " {}",
    "exec": "if command -v yay &>/dev/null; then yay -Qu | wc -l; elif command -v dnf &>/dev/null; then dnf check-update --quiet | grep -E '^[a-zA-Z0-9]' | wc -l; else echo 0; fi",
    "tooltip": true,
    "exec-tooltip": "if command -v yay &>/dev/null; then yay -Qu; elif command -v dnf &>/dev/null; then dnf check-update --quiet | grep -E '^[a-zA-Z0-9]'; else echo 'No updater found'; fi",
    "interval": 900,
    "on-click": "if command -v yay &>/dev/null; then kitty -T update yay -Syu --noconfirm && notify-send 'Arch has been updated'; elif command -v dnf &>/dev/null; then kitty -T update sudo dnf upgrade -y && notify-send 'Fedora has been updated'; fi"
  }
}
