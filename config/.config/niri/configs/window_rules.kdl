window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^kitty$"#
    default-column-width {}
}

window-rule {
    match title="^Picture-in-Picture$|^Picture in picture$"
    open-floating true
    default-floating-position x=0 y=0 relative-to="bottom-right"
  }

window-rule {
    match app-id=r#"^(|kdeconnect-indicator||wihotspot|eog|vlc|totem||Yad|nm-connection-editor|blueman-manager|pulsemixer|mousepad|org\.gnome\..*|org\.kde\..*)$"#
    open-floating true
}

window-rule {
    match app-id="org.gnome.Papers"
    open-floating false
}

window-rule {
    match title="^KDE Connect.*$"
    open-floating true
}
